{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "rootDir": "../",
    "outDir": "./dist",
    "resolveJsonModule": true,
    "paths": {
      "@/core": ["../core/src/index.ts"]
    },
    "declaration": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/**/*.spec.ts", "src/**/*.test.ts"]
}